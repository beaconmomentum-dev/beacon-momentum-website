# =============================================================================
# Beacon Momentum WWW — Environment Variables Reference
# =============================================================================
# Copy this file to .env and fill in the real values before building or running.
# The .env file is gitignored and must NEVER be committed to the repository.
# This .env.example file IS committed and serves as the authoritative reference.
# =============================================================================

# -----------------------------------------------------------------------------
# CLIENT-SIDE (baked into the JS bundle at build time — REQUIRED for build)
# -----------------------------------------------------------------------------

# Manus OAuth portal URL — the subdomain where the member platform lives
VITE_OAUTH_PORTAL_URL=https://app.beaconmomentum.com

# Manus App ID — the identifier registered with Manus OAuth for this app
VITE_APP_ID=beacon-momentum-www

# GoHighLevel Location ID — optional, used for location-specific GHL features
VITE_GHL_LOCATION_ID=

# Frontend Forge API — optional, leave blank if not using AI content features
VITE_FRONTEND_FORGE_API_KEY=
VITE_FRONTEND_FORGE_API_URL=

# Analytics (Umami) — optional, leave blank to disable analytics entirely
# If set, BOTH must be set together or neither will be injected into the page
VITE_ANALYTICS_ENDPOINT=
VITE_ANALYTICS_WEBSITE_ID=

# -----------------------------------------------------------------------------
# SERVER-SIDE (runtime environment — REQUIRED for the server to start)
# -----------------------------------------------------------------------------

NODE_ENV=production
PORT=3012

# Database connection string (DigitalOcean managed MySQL via private network)
DATABASE_URL=mysql://beacon_app:PASSWORD@10.108.0.2:3306/beacon_momentum

# JWT secret for session signing — must be a long random string
JWT_SECRET=change-me-to-a-long-random-secret

# OAuth server URL — must match VITE_OAUTH_PORTAL_URL
OAUTH_SERVER_URL=https://app.beaconmomentum.com

# GoHighLevel API key — server-only credential used by the public capture relay.
# Never prefix this value with VITE_ or expose it to browser code.
GHL_API_KEY=

# Cohort lead dashboard password (shared password for /the-watch/cohort)
COHORT_LEAD_PASSWORD=

# The Watch — Stripe-hosted direct annual checkout. The founding Payment Link
# must be card-only, require terms, use the $497/year price, and have a Stripe
# completed-sessions limit of 1000. With card-only payments, no trial, and no
# coupons, Stripe's completed-session count represents paid annual checkouts.
# The server sums Stripe's completed-session counts across two $497/year founder links:
# primary cap 999 plus final cap 1. It routes to the $997/year standard link only
# after their combined completed-session count reaches 1,000. Set the business Terms URL in Stripe Dashboard to
# https://beaconmomentum.com/terms. The flag remains off until all three links and
# their consent/cap settings have been independently verified. WATCH_BILLING_MODE
# must be explicitly LIVE or TEST; unset/invalid mode always fails closed.
# Never prefix any secret, price ID, or Payment Link ID with VITE_.
WATCH_BILLING_MODE=
WATCH_DIRECT_PAYMENT_ENABLED=false
WATCH_LIVE_CHECKOUT_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WATCH_ANNUAL_PRICE_ID=
STRIPE_WATCH_WEBHOOK_SECRET=
# Stripe caps each link at 999; aggregate the first 1,000 founders as 999 + 1.
STRIPE_WATCH_FOUNDING_PAYMENT_LINK_ID=
STRIPE_WATCH_FINAL_FOUNDING_PAYMENT_LINK_ID=
STRIPE_WATCH_STANDARD_PRICE_ID=
STRIPE_WATCH_STANDARD_PAYMENT_LINK_ID=

# Internal Stripe test-mode lifecycle validation only. Never reuse live credentials here.
# Set WATCH_BILLING_MODE=TEST and keep the independent test enable flag false
# outside an isolated staging environment.
WATCH_TEST_DIRECT_PAYMENT_ENABLED=false
STRIPE_TEST_SECRET_KEY=
STRIPE_TEST_PUBLISHABLE_KEY=
STRIPE_TEST_WATCH_ANNUAL_PRICE_ID=
STRIPE_TEST_WATCH_WEBHOOK_SECRET=
STRIPE_TEST_WATCH_FOUNDING_PAYMENT_LINK_ID=
STRIPE_TEST_WATCH_FINAL_FOUNDING_PAYMENT_LINK_ID=
STRIPE_TEST_WATCH_STANDARD_PRICE_ID=
STRIPE_TEST_WATCH_STANDARD_PAYMENT_LINK_ID=

# Owner OpenID — optional, used for admin-level auth checks
OWNER_OPEN_ID=

# Backend Forge API — optional, server-side AI content features
BUILT_IN_FORGE_API_KEY=
BUILT_IN_FORGE_API_URL=
